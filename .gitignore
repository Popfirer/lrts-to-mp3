# ==========================================================================
#  LRTS to mp3 —— 忽略规则
#  只把「源码 + 文档 + 图标」纳入版本库；运行时产物、第三方工具、二进制不入库
# ==========================================================================

# ---------- 运行时输出目录（转换结果，体积大且含版权内容）----------
workspace/
听书/

# ---------- Python 字节码 ----------
__pycache__/
*.py[cod]
*$py.class

# ---------- 本地构建 / 备份产物 ----------
_build/
_backup/
dist/
build/
*.spec

# ---------- 打包好的可执行文件与第三方工具（请自行获取，见 tools/README.md）----------
*.exe
tools/*
!tools/README.md

# ---------- 运行时生成的缓存 / 日志 ----------
online_cache.json
_convert_log.txt
_selftest.txt
*.log

# ---------- 临时文件 ----------
*.tmp
*.bak
*.swp
~$*
.~lock.*

# ---------- 编辑器 / 系统 ----------
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
